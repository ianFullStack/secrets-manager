# secrets.env.template
# Copy to secrets.env, fill in values, then run lock-secrets (or add keys one at a time
# with add-secret-gui). Format: one KEY=VALUE per line; blank lines and # comments allowed.
# This file holds key NAMES only, so it is safe to commit and safe for an AI agent to read.

# ai
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# dev
# GITHUB_TOKEN=ghp_...
# DATABASE_URL=postgres://user:password@localhost:5432/app

# payments
# STRIPE_SECRET_KEY=sk_test_...

# cloud
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# email
# SMTP_PASSWORD=...

# other (no category pattern matches, so these fall into default_category)
# JWT_SECRET=...
